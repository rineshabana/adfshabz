										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "d_users_bronze",
									"type": "DatasetReference",
									"parameters": {
										"api_data": {
											"value": "@concat(item(), '_', formatDateTime(utcNow(), 'dd-MM-yyyy_HH-mm-ss'), '.csv')\n",
											"type": "Expression"
										},
										"foldername": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"api_type": {
				"type": "array",
				"defaultValue": [
					"posts",
					"comments",
					"albums",
					"photos",
					"users"
				]
			}
		},
